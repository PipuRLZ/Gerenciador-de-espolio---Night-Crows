            def auto_check_elegivel(var_name, index, mode, v=v_dict):
                try:
                    valor_num = parse_valor(v['valor'].get())
                    if valor_num >= 30000000:
                        v['elegivel'].set(True)
                        v['bidou'].set(True)
                    else:
